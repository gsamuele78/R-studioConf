# Dockerfile for Biome Telemetry API Microservice
FROM python:3.14-slim

LABEL maintainer="docker-deploy-telemetry"

WORKDIR /app

# Dependencies are baked at build time from a pinned, hashed lock (HC-10/HC-11).
# --only-binary: every pin ships a cp314 / abi3 / pure-Python wheel, so no
# compiler is installed and a missing wheel fails the build instead of
# silently compiling from source (the python:3.14 failure of PR #33/#40).
COPY scripts/telemetry/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: \
        -r /app/requirements.txt

# Copy the telemetry application. The admin recipient list is site data (real
# e-mail addresses): it is NOT baked into the image but bind-mounted read-only
# from config/site/admin_recipients.txt by docker-compose.yml (config/SITE_OVERRIDE.md).
COPY scripts/telemetry/telemetry_api.py /app/telemetry_api.py

# The application runs as a FastAPI server on port 8000
# Given network_mode: host, it will bind to the host's 127.0.0.1:8000
CMD ["python", "telemetry_api.py"]
