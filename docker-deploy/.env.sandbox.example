# docker-deploy/.env.sandbox
# Local testing environment for R-studioConf Vagrant Sandbox.
# Uses test tokens and disabled external calls.

# RStudio General Configuration (image NAMES only: the tag comes from IMAGE_TAG)
RSTUDIO_SSSD_IMAGE=rstudio-botanical-sssd
RSTUDIO_SAMBA_IMAGE=rstudio-botanical-samba
RSTUDIO_MEMORY_LIMIT=2G
RSTUDIO_CPU_LIMIT=1.0
RAMDISK_SIZE=512M
DOCKER_USERID=1000
DOCKER_GROUPID=1000

# Proxy & SSL Configuration
# No Let's Encrypt in sandbox
LETSENCRYPT_MODE=disabled
NGINX_HOST=192.168.56.40

# Keycloak / SSO Configuration (assuming iam-host handles this, or disabled)
OAUTH2_PROXY_CLIENT_ID=sandbox-rstudio
OAUTH2_PROXY_CLIENT_SECRET=sandbox123
OAUTH2_PROXY_COOKIE_SECRET=00000000000000000000000000000000

# Fake PKI Fingerprint from upstream test
FINGERPRINT=sandbox-dummy-fingerprint
STEP_CA_ROOT_PATH=./shared-certs/step-ca-root.crt

# Host mount paths (sandbox overrides)
RSTUDIO_DATA_DIR=./data
RSTUDIO_CONFIG_DIR=./config

# Required by docker-compose.yml (no default there: `docker compose config`
# fails without them). Sandbox values for the rstudio-host VM (192.168.56.40).
IMAGE_TAG=sandbox
HOST_DOMAIN=192.168.56.40
HTTPS_PORT=8443
RSTUDIO_PORT=8787
HOST_HOME_DIR=/home
HOST_PROJECT_ROOT=/nfs/home
HOST_QUOTA_CACHE_DIR=/var/lib/biome-quota
# Self-signed pair from Ubuntu's ssl-cert package (present on the lab VMs).
SSL_CERT_PATH=/etc/ssl/certs/ssl-cert-snakeoil.pem
SSL_KEY_PATH=/etc/ssl/private/ssl-cert-snakeoil.key
